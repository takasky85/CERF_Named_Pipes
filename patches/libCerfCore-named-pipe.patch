+// Named-pipe endpoints. "pipe:NAME" / "\\\\.\\pipe\\NAME" connects to a pipe that another process
+// (e.g. 86Box in "server" mode) already created. "pipe-server:NAME" creates the pipe and waits for
+// the peer (e.g. 86Box in "client" mode) to connect.
+struct PipeSpec {
+    bool         is_pipe = false;
+    bool         server  = false;
+    std::wstring path;
+};
+
+PipeSpec ParsePipeSpec(const std::string& name) {
+    PipeSpec spec;
+    auto starts = [&](const char* prefix) {
+        const size_t n = strlen(prefix);
+        return name.size() > n && _strnicmp(name.c_str(), prefix, n) == 0;
+    };
+    std::string rest;
+    if (starts("pipe-server:"))      { spec.server = true; rest = name.substr(12); }
+    else if (starts("pipe:"))        { rest = name.substr(5); }
+    else if (starts("\\\\.\\pipe\\")) { rest = name.substr(9); }
+    else return spec;
+    spec.is_pipe = true;
+    spec.path    = L"\\\\.\\pipe\\" + Utf8ToWide(rest.c_str());
+    return spec;
+}
+
+}
