+// Extra named-pipe endpoints from CERF_SERIAL_PIPES, ';'-separated, each "pipe:NAME" (connect to a
+// pipe another program serves, e.g. 86Box "server") or "pipe-server:NAME" (create it and wait for
+// the peer, e.g. 86Box "client"). They show up in the serial-forward insert menu like COM ports.
+static void AppendConfiguredPipes(std::vector<std::string>& ports) {
+    char   buf[2048];
+    const DWORD n = GetEnvironmentVariableA("CERF_SERIAL_PIPES", buf, sizeof buf);
+    if (n == 0 || n >= sizeof buf) return;
+    std::string all(buf, n);
+    size_t pos = 0;
+    while (pos <= all.size()) {
+        size_t end = all.find(';', pos);
+        if (end == std::string::npos) end = all.size();
+        const std::string item = all.substr(pos, end - pos);
+        if (!item.empty()) ports.push_back(item);
+        pos = end + 1;
+    }
+}
